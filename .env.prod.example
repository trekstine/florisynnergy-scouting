# Copy to .env next to docker-compose.prod.yml and fill in.
#   cp .env.prod.example .env

# The domain that points (A record) at your EC2 Elastic IP. Caddy gets a TLS
# cert for it automatically, so DNS must resolve BEFORE you start the stack.
DOMAIN=scouting.yourfarm.com

# Strong random values — do NOT reuse the dev defaults.
POSTGRES_PASSWORD=change-me-strong-random
SECRET_KEY=change-me            # generate: openssl rand -hex 32


# Seed the demo farm on first boot (idempotent — only runs if the DB is empty).
# Set to false for a clean production database.
SEED_ON_STARTUP=true

# Legacy FloriSynergy API — source of the master chemical list (real buying
# prices). Used by Reference Data → Chemicals → "Import from FloriSynergy".
# Leave blank to disable the import.
#
# This file is a TEMPLATE and is committed. Never put the real key here —
# put it in `.env`, which .gitignore keeps out of the repo.
FLORI_API_KEY=
